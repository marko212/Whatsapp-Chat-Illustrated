{
  "name": "whatsapp-chat-viewer",
  "version": "1.0.0",
  "description": "Offline WhatsApp Chat Viewer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.whatsapp.viewer",
    "productName": "Whatsapp Chat Viewer",
    "win": {
      "target": [
        "portable"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ]
  }
}
